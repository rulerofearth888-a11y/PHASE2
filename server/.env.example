# Required for login, registration, products, orders, and other database-backed APIs.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sathyambio

# Use long random values in local development and production.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-another-long-random-secret

# Where admin uploads (product images, videos) are written. They are served
# from /uploads/<file>, and only the metadata goes in MongoDB, so this must be
# a real disk that keeps its contents between restarts - a folder on the
# server, or a mounted volume. Defaults to server/uploads.
# NOT suitable on Vercel or any serverless host: there the bundle is read-only
# and /tmp is wiped on every cold start, so uploaded files disappear.
UPLOADS_DIR=./uploads

# Optional local development settings.
PORT=5000
TEST_PHONE_NUMBERS=
# Machine translation of product text into Tamil, Kannada, Telugu and Hindi
# (server/productTranslate.js). Google Cloud Translation API key, restricted to
# that API. Empty = off: products show in English as before.
GOOGLE_TRANSLATE_API_KEY=
